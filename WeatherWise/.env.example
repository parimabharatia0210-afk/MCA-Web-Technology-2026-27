# Copy this file to .env for local configuration. Never commit .env.
PORT=3000

# Optional. Leave blank to use local forecast-based assistant guidance.
# Set your private Google AI Studio key here to enable Gemini features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: compatible reverse-geocoding endpoint. Defaults to OpenStreetMap Nominatim.
# REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
